        "import time\n",
        "import sys\n",
        "\n",
        "def loading_animation():\n",
        "    \"\"\"Displays a simple loading animation.\"\"\"\n",
        "    animation = \"|/-\\\\\"\n",
        "    for i in range(10):\n",
        "        time.sleep(0.1)\n",
        "        sys.stdout.write(\"\\r\" + animation[i % len(animation)] + \" Loading...\")\n",
        "        sys.stdout.flush()\n",
        "    sys.stdout.write(\"\\r\" + \" \" * 15 + \"\\r\") # Clear the loading animation line\n",
        "\n",
        "nama = \"Geraldo Imanuel Dwisanto\"\n",
        "hobi = 'gatau'\n",
        "tinggi_badan = 176\n",
        "alamat = 'Bukittinggi'\n",
        "\n",
        "\n",
        "loading_animation()\n",
        "print('nama saya :', nama)\n",
        "time.sleep(1)\n",
        "\n",
        "loading_animation()\n",
        "print('hobi saya :', hobi)\n",
        "time.sleep(1)\n",
        "\n",
        "loading_animation()\n",
        "print('tinggi saya :', tinggi_badan)\n",
        "time.sleep(1)\n",
        "\n",
        "loading_animation()\n",
        "print('alamat saya :', alamat)"
